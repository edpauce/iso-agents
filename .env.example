# Copy to .env.local (git-ignored) and fill in. The MCP server reads this file;
# the MCP client (Claude Desktop, Claude Code, Inspector) never sees the key.

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the default model (claude-sonnet-5).
# ANTHROPIC_MODEL=

# Optional: where generated .docx files are written (default: ./salidas).
# SALIDAS_DIR=

# Optional: folder with the normative reference files (default: ./normas).
# NORMAS_DIR=
